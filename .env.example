APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei

# XAMPP 剛裝好時：root、沒有密碼（只適合本機開發）。
# 建議改用 database/create_user.sql 建立的 quiz_app（DB_USER=quiz_app，DB_PASS 填你設定的密碼）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quiz_system
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=QUIZSESSID
SESSION_LIFETIME=7200
ATTEMPT_GRACE_SECONDS=5
