APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei

# XAMPP 預設：host 127.0.0.1、root、無密碼。建議改用 database/create_user.sql 建立的 quiz_app
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quiz_system
DB_USER=quiz_app
DB_PASS=change_me
DB_CHARSET=utf8mb4

SESSION_NAME=QUIZSESSID
SESSION_LIFETIME=7200
ATTEMPT_GRACE_SECONDS=5
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
